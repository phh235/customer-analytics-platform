# ── App ──────────────────────────────────────────────
APP_NAME=customer-analytics
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0

# ── API ──────────────────────────────────────────────
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:4000
IMPORT_STORAGE_DIR=storage/imports
MODEL_STORAGE_DIR=storage/models
# ── CORS ─────────────────────────────────────────────
# Danh sách origins được phép (cách nhau bởi dấu phẩy)
BACKEND_CORS_ORIGINS=["http://localhost:4000","http://127.0.0.1:4000","https://customer-analytics-app.vercel.app","https://azuki-store-dev.vercel.app"]

# ── Database ─────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=customer_analytics
POSTGRES_USER=customer_analytics
POSTGRES_PASSWORD=change_me


