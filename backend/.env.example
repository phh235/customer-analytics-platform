# ── App ──────────────────────────────────────────────
APP_NAME=customer-analytics
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0

# ── API ──────────────────────────────────────────────
API_V1_PREFIX=/api/v1

# ── Database ─────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=customer_analytics
POSTGRES_USER=customer_analytics
POSTGRES_PASSWORD=change_me

# ── Connection Pool ──────────────────────────────────
# DB_POOL_SIZE=10          # Số connections mặc định
# DB_MAX_OVERFLOW=20       # Số connections tối đa khi pool đầy
# DB_POOL_PRE_PING=True    # Kiểm tra connection trước khi dùng
# DB_POOL_TIMEOUT=30       # Timeout chờ connection (giây)
# DB_POOL_RECYCLE=1800     # Time sống tối đa của connection (giây)

# ── JWT ──────────────────────────────────────────────
JWT_SECRET_KEY=change_me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=7

# ── Logging ──────────────────────────────────────────
LOG_LEVEL=INFO
