# ── App ──────────────────────────────────────────────
APP_NAME=customer-analytics
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0

# ── API ──────────────────────────────────────────────
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:4000
IMPORT_STORAGE_DIR=storage/imports
MODEL_STORAGE_DIR=storage/models
# ── CORS ─────────────────────────────────────────────
# Danh sách origins được phép (cách nhau bởi dấu phẩy)
BACKEND_CORS_ORIGINS=["http://localhost:4000","http://127.0.0.1:4000","https://customer-analytics-app.vercel.app"]

# ── Database ─────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=customer_analytics
POSTGRES_USER=customer_analytics
POSTGRES_PASSWORD=change_me


# ── Database ─────────────────────────────────────────                                                                     │
│ -16│POSTGRES_HOST=ep-muddy-paper-aw4oba7r-pooler.c-12.us-east-1.aws.neon.tech                                                   │
│ -17│POSTGRES_PORT=5432                                                                                                          │
│ +16│POSTGRES_HOST=localhost                                                                                                     │
│ +17│POSTGRES_PORT=15432                                                                                                         │
│  18│POSTGRES_DB=customer_analytics                                                                                              │
│ -19│POSTGRES_USER=neondb_owner                                                                                                  │
│ -20│POSTGRES_PASSWORD=HoangNamDev_UIT                                                                                           │
│ +19│POSTGRES_USER=root                                                                                                          │
│ +20│POSTGRES_PASSWORD=root123

# ── Connection Pool ──────────────────────────────────
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_PRE_PING=True
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ── JWT ──────────────────────────────────────────────
JWT_SECRET_KEY=change_me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=7

# ── Google OAuth2 ────────────────────────────────────
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ── Email / password reset ───────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=Customer Analytics
SMTP_USE_TLS=True

# ── Cloudinary ───────────────────────────────────────
# Leave blank until Cloudinary credentials are available.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PRODUCT_FOLDER=customer-analytics/products
CLOUDINARY_CUSTOMER_FOLDER=customer-analytics/customers

# ── AI chat ───────────────────────────────────────────────
# Keep the key on the backend; never expose it to the frontend.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=30
GROQ_TEMPERATURE=0.7
GROQ_MAX_COMPLETION_TOKENS=1024
GROQ_REASONING_FORMAT=hidden
# GPT-OSS supports low/medium/high; "low" minimizes reasoning tokens.
# Qwen 3.8 additionally supports "none" to disable reasoning tokens.
GROQ_REASONING_EFFORT=low

# ── Controlled analytics gateway ─────────────────────────
# Required: a separate PostgreSQL URL owned by a SELECT-only ai_analytics role.
AI_ANALYTICS_DATABASE_URL=
AI_ANALYTICS_STATEMENT_TIMEOUT_MS=3000
AI_ANALYTICS_MAX_RESULT_ROWS=100
AI_ANALYTICS_MAX_SQL_LENGTH=10000
AI_ANALYTICS_MAX_JOINS=5
AI_ANALYTICS_MAX_QUERY_COST=100000


# ── Logging ──────────────────────────────────────────
LOG_LEVEL=INFO

# Business analytics
ANALYSIS_TIMEZONE=Asia/Ho_Chi_Minh
VALID_ORDER_STATUSES=["PAID","COMPLETED","DELIVERED","PARTIAL_REFUNDED"]

# Script_Duan potential score weights and quintile ranking
SCORE_WEIGHT_RECENCY=0.35
SCORE_WEIGHT_FREQUENCY=0.30
SCORE_WEIGHT_MONETARY=0.20
SCORE_WEIGHT_INTERACTION=0.15
SCORE_COMPONENT_MAX=5
SCORE_SCALE_MULTIPLIER=20
SCORING_CONFIGURATION_VERSION=SCRIPT_DUAN_V4_EXCEL_PARITY

# ML acceptance gates
ML_MIN_LIFT_TOP10=2.0
ML_MIN_PRECISION_TOP10_MULTIPLIER=2.0
ML_BASELINE_PR_AUC=0.0
ML_PRIORITY_PROBABILITY_THRESHOLD=0.5
