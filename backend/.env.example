# ── App ──────────────────────────────────────────────
APP_NAME=customer-analytics
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0

# ── API ──────────────────────────────────────────────
API_V1_PREFIX=/api/v1

# ── CORS ─────────────────────────────────────────────
# Danh sách origins được phép (cách nhau bởi dấu phẩy)
BACKEND_CORS_ORIGINS=["http://localhost:4000","http://127.0.0.1:4000","https://customer-analytics-app.vercel.app","https://azuki-store-dev.vercel.app"]

# ── Database ─────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=customer_analytics
POSTGRES_USER=customer_analytics
POSTGRES_PASSWORD=change_me

# ── Connection Pool ──────────────────────────────────
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_PRE_PING=True
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ── JWT ──────────────────────────────────────────────
JWT_SECRET_KEY=change_me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=7

# ── Logging ──────────────────────────────────────────
LOG_LEVEL=INFO
