# ── Connection Pool ──────────────────────────────────
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_PRE_PING=True
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ── JWT ──────────────────────────────────────────────
JWT_SECRET_KEY=change_me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=7

# ── Google OAuth2 ────────────────────────────────────
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ── Cloudinary ───────────────────────────────────────
# Leave blank until Cloudinary credentials are available.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PRODUCT_FOLDER=customer-analytics/products

# ── Logging ──────────────────────────────────────────
LOG_LEVEL=INFO

# Business analytics
ANALYSIS_TIMEZONE=Asia/Ho_Chi_Minh
VALID_ORDER_STATUSES=["PAID","COMPLETED","DELIVERED","PARTIAL_REFUNDED"]

# Potential score weights
SCORE_WEIGHT_RECENCY=0.30
SCORE_WEIGHT_FREQUENCY=0.25
SCORE_WEIGHT_MONETARY=0.20
SCORE_WEIGHT_INTERACTION=0.15
SCORE_WEIGHT_TREND=0.10
SCORING_CONFIGURATION_VERSION=CONFIG_V1
SEGMENT_HIGH_VALUE_SCORE=80
SEGMENT_LOYAL_SCORE=80
SEGMENT_AT_RISK_RECENCY_DAYS=60
SEGMENT_NEW_CUSTOMER_DAYS=30

# ML acceptance gates
ML_MIN_LIFT_TOP10=2.0
ML_MIN_PRECISION_TOP10_MULTIPLIER=2.0
ML_BASELINE_PR_AUC=0.0
ML_PRIORITY_PROBABILITY_THRESHOLD=0.5

